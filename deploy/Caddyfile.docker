# Caddy — DOCKER-COMPOSE mode (static frontends + API reverse proxy)
# ===================================================================
# Frontends are served as PRE-BUILT static files, not dev servers.
# Build them on the host first (see deploy/README.md), then docker-compose
# mounts each dist/ read-only into this container:
#
#   persona-nexus-lobby/dist     -> /srv/lobby
#   persona-nexus-auth/dist      -> /srv/auth
#   persona-nexus-character/dist -> /srv/character
#   persona-nexus-chat/dist      -> /srv/chat
#
# Only /api/* is proxied — to the gateway container (Docker DNS service name).
#
# Path layout (single origin):
#   /api/*      -> gateway:8000
#   /login*     -> auth dist       (Vite base /login/)
#   /character* -> character dist  (Vite base /character/)
#   /chat*      -> chat dist       (Vite base /chat/)
#   everything else -> lobby dist  (Vite base /)   [default fallback]
#
# `uri strip_prefix` removes the mount path so it maps onto the dist layout:
# a request for /login/assets/x.js becomes /assets/x.js -> /srv/auth/assets/x.js.
# `try_files ... /index.html` gives each app its SPA fallback for client routes.

:8080 {
	log {
		level DEBUG
	}

	encode gzip

	# --- API ---
	handle /api/* {
		reverse_proxy gateway:8000
	}

	# --- Auth frontend ---
	handle /login* {
		root * /srv/auth
		uri strip_prefix /login
		try_files {path} /index.html
		file_server
	}

	# --- Character frontend (multi-page: index, creator-create, creator-edit) ---
	handle /character* {
		root * /srv/character
		uri strip_prefix /character
		try_files {path} /index.html
		file_server
	}

	# --- Chat frontend ---
	handle /chat* {
		root * /srv/chat
		uri strip_prefix /chat
		try_files {path} /index.html
		file_server
	}

	# --- Lobby frontend (default) ---
	# Catches "/", "/assets/*", "/src/*.html" partials, and client routes
	# such as /my-characters, which fall back to index.html.
	handle {
		root * /srv/lobby
		try_files {path} /index.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# Production: same layout, real domain. Caddy auto-provisions HTTPS via
# Let's Encrypt when the domain resolves here and ports 80/443 are reachable.

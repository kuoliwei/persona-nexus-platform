# Copy to .env and fill in. docker-compose reads this file automatically.

# REQUIRED. Must be identical to auth-service's JWT_SECRET: auth-service signs
# tokens, the gateway verifies them. compose refuses to start without it.
JWT_SECRET=

# The browser-facing origin. Same-origin deployment means this is the only origin
# the frontends ever talk to.
#   local:      http://localhost:8080
#   production: https://your-domain
PUBLIC_ORIGIN=http://localhost:8080

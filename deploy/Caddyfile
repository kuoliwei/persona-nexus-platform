# Caddy reverse proxy — MANUAL / HOST development mode
# =====================================================
# Use this when running everything directly on the host (no Docker):
#   caddy run --config ./Caddyfile --adapter caddyfile
# with the four Vite dev servers + api-gateway running on localhost.
#
# For docker-compose, use Caddyfile.docker instead (service names, not localhost).
#
# Routing (single origin, path-based):
#   /api/*      → api-gateway (8000)
#   /login*     → auth frontend      (Vite base /login/)
#   /character* → character frontend (Vite base /character/)
#   /chat*      → chat frontend      (Vite base /chat/)
#   everything else → lobby frontend (Vite base /)   [default fallback]

:8080 {
	log {
		level DEBUG
	}

	# API Gateway — all /api/* requests. Must come before the lobby fallback.
	handle /api/* {
		reverse_proxy localhost:8000
	}

	# Auth frontend
	handle /login* {
		reverse_proxy localhost:5173
	}

	# Character frontend
	handle /character* {
		reverse_proxy localhost:5174
	}

	# Chat frontend
	handle /chat* {
		reverse_proxy localhost:5176
	}

	# Lobby frontend — default handler.
	# Catches "/", "/assets/*", and any path not matched above.
	handle {
		reverse_proxy localhost:5175
	}
}
